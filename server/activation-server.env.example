# Copy this file to server/activation-server.env for local runs, or inject the
# same variables in your production activation server environment.

# Network
PORT=3001
ACTIVATION_PORT=3001
ACTIVATION_SERVER_URL=http://localhost:3001
APP_PUBLIC_URL=http://localhost:3001

# Core activation signing
ADMIN_SECRET=replace-with-a-long-random-secret
ACTIVATION_PRIVATE_KEY_BASE64=replace-with-pkcs8-der-base64

# Storage
DATABASE_URL=postgresql://postgres:Ichiwoah123.@db.wfqwcrhmtkavjapziwzg.supabase.co:5432/postgres
# Supabase Postgres should use SSL.
DATABASE_SSL=require
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Xendit Billing
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_API_BASE=https://api.xendit.co
XENDIT_API_VERSION=2026-01-01
XENDIT_QR_DOWNLOAD_AMOUNT=
XENDIT_TEMPLATE_EDITOR_AMOUNT=
